# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/events"
# Direct (non-pooled) connection for migrations. Locally it is the same as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/events"

# --- Public URL of this web app (used for payment callbacks, emails) ---
APP_URL="http://localhost:3000"

# --- Secrets (generate long random strings: openssl rand -hex 32) ---
JWT_SECRET="change-me"
QR_SECRET="change-me-too"
CRON_SECRET="change-me-cron"

# --- Moyasar (https://dashboard.moyasar.com) ---
# Leave empty in development to use the built-in mock payment page.
# MOYASAR_MOCK=1 forces the mock page in a production build (automated tests only — never in real production).
MOYASAR_MOCK=""
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""
# Secret token configured on the Moyasar webhook
MOYASAR_WEBHOOK_SECRET=""
# Apple Pay merchant domain validation requires a verified domain on Moyasar
MOYASAR_APPLE_PAY_LABEL="Events Platform"

# --- Email (SMTP) for password reset. If empty, emails are printed to the console ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Events Platform <no-reply@example.com>"

# --- File storage (Vercel Blob). Set automatically when you connect a Blob store on Vercel.
# If empty, uploads are stored on local disk (./uploads) — development only.
BLOB_READ_WRITE_TOKEN=""

# --- Expo push (optional access token if push security is enabled on your Expo account) ---
EXPO_ACCESS_TOKEN=""

# --- Google Maps key for the event location picker in the organizer dashboard ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
